{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alanocut.local/schemas/cut-plan.schema.json",
  "title": "Editorial cut plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact", "revision", "diagnosis_revision", "status",
    "archetype", "narrative_objective", "pacing_strategy", "target_duration_seconds",
    "beats", "global_exclusions", "open_questions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact": {"const": "cut_plan"},
    "revision": {"type": "integer", "minimum": 1},
    "diagnosis_revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["ready", "needs_human_review"]},
    "archetype": {
      "enum": [
        "documentary_narrative", "educational_explainer", "event_recap",
        "interview", "podcast_excerpt", "product_demo", "sales_vsl",
        "social_talking_head", "testimonial_case_study", "tutorial", null
      ]
    },
    "narrative_objective": {"type": "string", "minLength": 1, "maxLength": 500},
    "pacing_strategy": {"type": "string", "minLength": 1, "maxLength": 1000},
    "target_duration_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "position", "purpose", "required", "selection_requirements", "candidates", "transition_intent"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "position": {"type": "integer", "minimum": 1},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
          "required": {"type": "boolean"},
          "selection_requirements": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}, "minItems": 1},
          "candidates": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "minItems": 1},
          "transition_intent": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "global_exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}},
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}, "uniqueItems": true}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "start", "end", "quote", "selection_note"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "exclusiveMinimum": 0},
        "quote": {"type": "string", "minLength": 1, "maxLength": 1000},
        "selection_note": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "start", "end", "reason"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "exclusiveMinimum": 0},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}

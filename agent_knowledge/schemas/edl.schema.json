{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alanocut.local/schemas/edl.schema.json",
  "title": "Alano Cut editorial EDL",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "metadata", "sources", "ranges", "total_duration_s"],
  "properties": {
    "version": {"const": 1},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeline_name", "video_type", "content_number", "content_slug",
        "sequence_fps", "diagnosis_revision", "plan_revision", "required_beats"
      ],
      "properties": {
        "timeline_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "video_type": {"type": "string", "minLength": 1, "maxLength": 80},
        "content_number": {"type": ["string", "null"], "maxLength": 40},
        "content_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$", "maxLength": 100},
        "sequence_fps": {"type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"},
        "diagnosis_revision": {"type": "integer", "minimum": 1},
        "plan_revision": {"type": "integer", "minimum": 1},
        "required_beats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "evidence_any_of"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "description": {"type": "string", "minLength": 1, "maxLength": 500},
              "evidence_any_of": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1, "maxLength": 200},
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
      "additionalProperties": {
        "type": "string",
        "pattern": "^source:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "start", "end", "beat_id", "quote", "reason", "is_list"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "source": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "beat_id": {"$ref": "#/$defs/id"},
          "quote": {"type": "string", "minLength": 1, "maxLength": 4000},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
          "is_list": {"type": "boolean"}
        }
      }
    },
    "total_duration_s": {"type": "number", "exclusiveMinimum": 0}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}
  }
}

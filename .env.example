# ==========================================
# Alano Rough Cut AI - Environment Variables
# ==========================================

# --- OpenAI-Compatible LLM Orchestrator (NVIDIA NIM, OpenAI, Ollama, vLLM, Groq, etc.) ---
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-70b-instruct

# --- Cloud Transcription Providers (Optional) ---
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=

# --- HuggingFace (Optional: for gated models if needed) ---
HF_TOKEN=
